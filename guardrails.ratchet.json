{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 5,
    "anti-slop/no-known-value-widening": 3,
    "anti-slop/no-runtime-typeof": 3,
    "anti-slop/no-unknown-parameters": 41,
    "anti-slop/no-unknown-returns": 7,
    "anti-slop/no-unsafe-dictionary-type": 20,
    "anti-slop/require-safety-comment-for-type-assertion": 25,
    "typescript/no-unsafe-argument": 76,
    "typescript/no-unsafe-assignment": 471,
    "typescript/no-unsafe-return": 126,
    "typescript/use-unknown-in-catch-callback-variable": 2
  },
  "oversizeFiles": {}
}
