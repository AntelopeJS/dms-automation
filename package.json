{
  "name": "dms-automation-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "typecheck": "pnpm --dir packages/interface-dms-automation build && pnpm --dir packages/dms-automation exec tsc --noEmit",
    "knip": "pnpm --filter \"./packages/*\" -r knip",
    "lint": "pnpm --dir packages/dms-automation/frontend-vue lint && oxlint",
    "lint:fix": "pnpm --dir packages/dms-automation/frontend-vue lint:fix && oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "prepare": "if [ -e .git ] && command -v git >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1 && GIT_DIR=.git GIT_WORK_TREE=. git rev-parse --git-dir >/dev/null 2>&1; then GIT_DIR=.git GIT_WORK_TREE=. lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync",
    "sync:check": "antelopejs-sync --check",
    "format:check": "oxfmt --check .",
    "test": "pnpm --dir packages/dms-automation test",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update",
    "e2e": "playwright test -c e2e",
    "e2e:build": "pnpm run build && ln -sfn ../../packages/dms-automation/node_modules e2e/playground/node_modules && packages/dms-automation/node_modules/.bin/tsc -p e2e/playground/tsconfig.build.json",
    "test:journeys": "node --test --test-isolation=none e2e/integration/*.journeys.test.mjs"
  },
  "devDependencies": {
    "@antelopejs/dms": ">=0.25.3 <0.26.0",
    "@antelopejs/tooling-configs": "^0.10.15",
    "@playwright/test": "~1.65.0",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mongodb-memory-server": "^11.3.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5"
  },
  "packageManager": "pnpm@10.34.9",
  "antelopeJs": {
    "docs": {
      "standard": true
    }
  }
}
