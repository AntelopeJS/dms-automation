{
  "name": "dms-automation-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "typecheck": "pnpm --dir packages/interface-dms-automation build && pnpm --dir packages/dms-automation exec tsc --noEmit",
    "knip": "pnpm --filter \"./packages/*\" -r knip",
    "lint": "oxlint && pnpm --dir packages/dms-automation/frontend-vue lint && antelopejs-check-interface-ranges",
    "lint:fix": "oxlint --fix && oxfmt . && pnpm --dir packages/dms-automation/frontend-vue lint:fix",
    "format": "oxfmt .",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check",
    "format:check": "oxfmt --check .",
    "test": "pnpm --dir packages/dms-automation test",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.2.17",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "packageManager": "pnpm@10.2.0"
}
