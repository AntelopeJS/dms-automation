{
  "rules": {
    "anti-slop/no-chained-type-assertions": 0,
    "anti-slop/no-unknown-parameters": 0,
    "eslint/max-params": 0,
    "typescript/no-base-to-string": 0,
    "typescript/unbound-method": 0
  },
  "tsExpectError": 0,
  "tsIgnore": 0,
  "safety": 0,
  "config": {
    "no-redeclare for packages/dms-automation/frontend-vue/**/*.{ts,vue}": 0,
    "no-undef for packages/dms-automation/frontend-vue/**/*.{ts,vue}": 0,
    "no-unused-vars for packages/dms-automation/frontend-vue/**/*.{ts,vue}": 1,
    "vue/multi-word-component-names for packages/dms-automation/frontend-vue/**/*.{ts,vue}": 0
  },
  "agentFiles": true
}
