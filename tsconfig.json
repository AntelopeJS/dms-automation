{
  // Shared compiler options for every package in the workspace. Nothing here
  // may carry a path: `extends` resolves relative paths against the file that
  // declares them, so `rootDir`, `outDir` and `tsBuildInfoFile` stay in the
  // package configs.
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "preserveConstEnums": true,
    "useDefineForClassFields": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "incremental": true
  }
}
