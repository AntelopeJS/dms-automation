{
  "name": "@antelopejs/interface-dms-automation",
  "version": "0.0.2",
  "description": "AntelopeJS interface for the DMS automation module: declare trigger, action and data node types from any module",
  "keywords": [
    "antelopejs",
    "automation",
    "dms",
    "interface"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-automation.git"
  },
  "files": [
    "dist",
    "skills",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/*": [
        "dist/*",
        "dist/*/index.d.ts"
      ],
      "*": [
        "dist/*",
        "dist/*/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "lint": "oxlint && oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt .",
    "format": "oxfmt .",
    "release": "pnpm run lint && pnpm run build && pnpm run check:exports && pnpm run check:consumer && release-it",
    "prepack": "pnpm run build",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "devDependencies": {
    "@antelopejs/interface-core": ">=0.0.13 <1.0.0",
    "@antelopejs/tooling-configs": ">=0.0.6 <1.0.0",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@antelopejs/interface-core": ">=0.0.13 <1.0.0"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {
    "skills": [
      "./skills"
    ]
  }
}
