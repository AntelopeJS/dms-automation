{
  "name": "@antelopejs/interface-dms-automation",
  "version": "0.5.0",
  "description": "AntelopeJS interface for the DMS automation module: declare trigger, action and data node types from any module.",
  "keywords": [
    "antelopejs",
    "automation",
    "dms",
    "interface"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/automation/extending",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-automation/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-automation.git",
    "directory": "packages/interface-dms-automation"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "docs",
    "skills",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "lint": "oxlint && oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "release": "pnpm run lint && pnpm run build && pnpm run check:exports && release-it",
    "prepack": "pnpm run build",
    "check:exports": "node scripts/check-exports.mjs",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "devDependencies": {
    "@antelopejs/interface-core": "file:../../.campaign/tgz/antelopejs-interface-core-52413a9.tgz",
    "@antelopejs/tooling-configs": "file:../../.campaign/tgz/antelopejs-tooling-configs-c5ffa8e.tgz",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "overrides": {
      "@antelopejs/tooling-configs": "file:../../.campaign/tgz/antelopejs-tooling-configs-c5ffa8e.tgz",
      "@antelopejs/interface-core": "file:../../.campaign/tgz/antelopejs-interface-core-52413a9.tgz"
    }
  },
  "antelopeJs": {
    "skills": [
      "./skills"
    ]
  }
}
