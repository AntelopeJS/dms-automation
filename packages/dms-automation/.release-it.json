{
  "git": {
    "commitMessage": "chore(release): @antelopejs/dms-automation v${version}",
    "tagName": "v${version}",
    "requireCommits": true
  },
  "github": {
    "release": true,
    "releaseName": "@antelopejs/dms-automation v${version}"
  },
  "hooks": {
    "before:init": [
      "pnpm --dir ../.. install --frozen-lockfile --ignore-scripts --filter dms-automation-workspace --filter @antelopejs/dms-automation-frontend-vue",
      "pnpm lint"
    ],
    "after:bump": ["git add CHANGELOG.md"]
  },
  "plugins": {
    "release-it-changelogen": {
      "disableVersion": true
    }
  },
  "npm": {
    "skipChecks": true
  }
}
