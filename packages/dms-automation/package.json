{
  "name": "@antelopejs/dms-automation",
  "version": "0.1.5",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-automation.git"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "frontend-vue",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm --filter @antelopejs/interface-dms-automation build && rimraf dist && tsc",
    "test:frontend-registration": "pnpm run build && node --test tests/frontend-registration.test.cjs",
    "test:release-script": "node --test tests/release-script.test.cjs",
    "test:type-origin": "pnpm run build && node --test tests/type-origin.test.cjs",
    "dev": "ajs project run -w -p playground",
    "lint": "oxlint && oxfmt --check . && cd frontend-vue && pnpm lint",
    "typecheck": "pnpm --filter @antelopejs/interface-dms-automation typecheck && tsc --noEmit",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && cd frontend-vue && pnpm lint:fix",
    "format": "oxfmt .",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "release": "pnpm --filter @antelopejs/interface-dms-automation build && pnpm --dir frontend-vue install --frozen-lockfile && pnpm lint && pnpm typecheck && pnpm test:frontend-registration && pnpm run verify:interface && release-it",
    "verify:interface": "node scripts/verify-interface-package.cjs",
    "prepack": "pnpm run build",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.14 <1.0.0",
    "@antelopejs/interface-api-util": "^0.1.2",
    "@antelopejs/interface-core": ">=0.1.1 <1.0.0",
    "@antelopejs/interface-data-api": "^0.1.9",
    "@antelopejs/interface-database": "0.1.7",
    "@antelopejs/interface-database-decorators": ">=0.1.6 <1.0.0",
    "@antelopejs/interface-dms": ">=0.2.0 <1.0.0",
    "@antelopejs/interface-dms-automation": ">=0.1.0 <1.0.0",
    "defu": "^6.1.4",
    "node-cron": "^4.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@antelopejs/core": "1.9.1",
    "@antelopejs/tooling-configs": ">=0.0.6 <1.0.0",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@antelopejs/interface-redis": ">=0.0.8 <1.0.0"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [
      "@antelopejs/interface-dms-automation"
    ]
  }
}
