{
  "name": "@antelopejs/dms-automation",
  "version": "0.5.0",
  "description": "Visual automation builder for the AntelopeJS DMS: procedures as node graphs started by schedules, webhooks, manual runs or DMS events, with a trace for every run.",
  "keywords": [
    "antelopejs",
    "automation",
    "dms",
    "dms-module",
    "workflow"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/automation",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-automation/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-automation.git",
    "directory": "packages/dms-automation"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "frontend-vue",
    "package.json",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm --filter @antelopejs/interface-dms-automation build && rimraf dist && tsc",
    "test": "pnpm run build && node --test tests/*.test.cjs",
    "test:frontend-registration": "pnpm run build && node --test tests/frontend-registration.test.cjs",
    "test:run-storage": "pnpm run build && node --test tests/run-storage.test.cjs",
    "test:runs-display": "pnpm run build && node --test tests/runs-display.test.cjs",
    "test:type-origin": "pnpm run build && node --test tests/type-origin.test.cjs",
    "test:type-display": "node --test tests/type-display.test.cjs",
    "test:unit": "pnpm run build && node --test tests/health.test.cjs tests/kpi.test.cjs tests/graph-issues.test.cjs tests/trace.test.cjs tests/schedule.test.cjs tests/pages.test.cjs tests/procedures-page.test.cjs tests/wording.test.cjs tests/health-banner.test.cjs tests/runtime-nodes.test.cjs tests/runs-api.test.cjs tests/run-detail.test.cjs tests/graph-connect.test.cjs tests/library.test.cjs tests/template-delete.test.cjs tests/template-comments.test.cjs tests/overview.test.cjs tests/declared-procedures.test.cjs tests/trigger-rearm.test.cjs tests/module-departure.test.cjs tests/run-procedure.test.cjs",
    "dev": "ajs project run -w -p playground",
    "lint": "oxlint && oxfmt --check . && cd frontend-vue && pnpm lint && antelopejs-check-interface-ranges",
    "typecheck": "pnpm --filter @antelopejs/interface-dms-automation typecheck && tsc --noEmit",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && cd frontend-vue && pnpm lint:fix",
    "format": "oxfmt .",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "release": "pnpm --filter @antelopejs/interface-dms-automation build && pnpm --dir frontend-vue install --frozen-lockfile && pnpm lint && pnpm typecheck && pnpm test:frontend-registration && pnpm run verify:interface && release-it",
    "verify:interface": "node scripts/verify-interface-package.cjs",
    "prepack": "pnpm run build",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.15 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.1.3 <1.0.0",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.2.2 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.10 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.9 <1.0.0",
    "@antelopejs/interface-dms": ">=0.8.0 <1.0.0",
    "@antelopejs/interface-dms-automation": ">=0.3.0 <0.4.0",
    "defu": "^6.1.4",
    "node-cron": "^4.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@antelopejs/core": "1.16.0",
    "@antelopejs/tooling-configs": ">=0.0.9 <1.0.0",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@antelopejs/interface-redis": ">=0.0.9 <1.0.0"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [
      "@antelopejs/interface-dms-automation"
    ],
    "skills": [
      "./skills"
    ]
  }
}
