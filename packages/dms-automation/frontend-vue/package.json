{
  "name": "@antelopejs/dms-automation-frontend-vue",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" build",
    "typecheck": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" typecheck",
    "format": "prettier --write .",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint . --max-warnings=3 && node node_modules/@antelopejs/dms/frontend-vue/scripts/check-api-error-presentation.mjs app",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@vue-flow/core": "^1.48.2",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@antelopejs/dms": ">=0.13.1 <1.0.0",
    "@antelopejs/dms-frontend": ">=0.10.0 <0.11.0",
    "@antelopejs/tooling-configs": ">=0.2.18 <1.0.0",
    "@eslint/js": "^9.0.0",
    "@nuxt/ui": "4.10.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.4",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.1.1"
  },
  "engines": {
    "@antelopejs/dms-frontend": ">=0.10.0 <0.11.0"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "overrides": {
      "@antelopejs/interface-database": "0.3.0",
      "@antelopejs/interface-api": "0.2.0",
      "@antelopejs/interface-api-util": "0.3.0",
      "@antelopejs/interface-database-decorators": "0.2.0",
      "@antelopejs/interface-data-api": "0.6.0",
      "@antelopejs/interface-dms": "file:../../../.campaign/tgz/antelopejs-interface-dms-14e671d.tgz",
      "@antelopejs/dms": "file:../../../.campaign/tgz/antelopejs-dms-14e671d.tgz",
      "@antelopejs/interface-core": "0.4.0"
    }
  }
}
